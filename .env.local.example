# Merqueo MOS — environment
# Copy to .env.local. Leave blank to run in zero-config DEMO mode
# (localStorage-backed data, per-user passwords created on first login).
#
# Fill both values to go LIVE against Supabase: real auth, RLS, persistence.
# Requires the schema (supabase/migrations) applied and users created first.

NEXT_PUBLIC_SUPABASE_URL=
# New publishable key (sb_publishable_…). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
# is also accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
